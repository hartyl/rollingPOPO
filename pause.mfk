array(Sprite) spr [16] @0x228

array socketOwner[8*8]
byte heartX
byte heartY

const array(pointer) socketCells =              [heartSocketCells,       blasterSocketCells,        energySocketCells,        bubbleWrapCells,        spikesCells,        Cells2x1,         gunCells,        gunCells         ]
const array(pointer) socketTiles =              [heartSocketTiles,       blasterSocketTiles,        energySocketTiles,        bubbleWrapTiles,        spikesTiles,        doubleHeartTiles, gunTiles,        gunTiles         ]
const array(function.void.to.void) socketPut =  [heartPut,               blasterPut,                energyPut,                bubbleWrapPut,          spikesPut,          doubleHeartPut,   gun1Put,         gun2Put          ]
const array(function.void.to.void) socketPull = [heartPull,              blasterPull,               energyPull,               bubbleWrapPull,         spikesPull,         doubleHeartPull,  gun1Pull,        gun2Pull         ]
const array socketCellsLengths =                [heartSocketCells.length,blasterSocketCells.length, energySocketCells.length, bubbleWrapCells.length, spikesCells.length, Cells2x1.length,  gunCells.length, gunCells.length-1]
const array prices =                            [0,                      2,                         5,                        1,                      8,                  4,                20,              15               ]

byte getRow(byte y, byte j) {
  return (y-PAUSETOPWALL)/2 + j/8
}

void placeOnSocket(byte x, byte y, byte a) {
  ppu_mask = 0
  ppu_ctrl = 0
  byte i
  byte j
  byte id
  id = ((y-PAUSETOPWALL)/2)*8 + ((x-PAUSELEFTWALL)/2)
  pointer socketCell
  socketCell = socketCells[a]
  pointer socketTile
  socketTile = socketTiles[a]
  read_ppu_status()
  for i,0,until,socketCellsLengths[a] {
    j = socketCell[i]
    ppu_set_addr(ppu_nametable_ram+$400+word(y+(word(j)/8)*2) * 32+ x+(word(j)&7)*2)
    ppu_write_data(socketTile[i*4+0])
    ppu_write_data(socketTile[i*4+1])
    ppu_set_addr(ppu_nametable_ram+$400+word(y+(word(j)/8)*2+1) * 32+ x+(word(j)&7)*2)
    ppu_write_data(socketTile[i*4+2])
    ppu_write_data(socketTile[i*4+3])
    socketOwner[id+j] = (id+socketCell[0])|128
    sockets[getRow(y,j)] &= (-1)-POWS2[7- ((x-PAUSELEFTWALL)/2+(j&7))]
  }
  socketOwner[id+socketCell[0]] = 64+128 + a
  ppu_wait_vblank()
  ppu_mask = %00011000
  ppu_ctrl = %10010000
}

byte removeFromSocket(byte x, byte y) {
  ppu_mask = 0
  ppu_ctrl = 0
  byte i
  byte j
  byte id
  id = socketOwner[((y-PAUSETOPWALL)/2)*8 + ((x-PAUSELEFTWALL)/2)] // origin or id
  if id & 128 == 0 {return 0} // air
  if id & 64 == 0 { // not origin, pointer
    //TODO make this coordinate relative to origin
    x = ((id & %111))*2+PAUSELEFTWALL
    y = ((id/8) & %111)*2+PAUSETOPWALL
    id = socketOwner[((y-PAUSETOPWALL)&(-2))*4 + ((x-PAUSELEFTWALL)/2)] // get pointed id
  }
  byte a
  a = id & %111111 // lower part (id)
  pointer socketCell
  socketCell = socketCells[a]
  read_ppu_status()
  byte origin
  origin = ((y-PAUSETOPWALL)&(-2))*4 + (x-PAUSELEFTWALL)/2 - socketCell[0]
  byte oy
  oy = ((origin/8) & %111)*2+PAUSETOPWALL
  for i,0,until,socketCellsLengths[a] {
    j = socketCell[i]
    //TODO make a custom printable chip
    //TODO set color for backgroundchip
    //ppu_set_addr(ppu_nametable_ram+$400+word(y+(word(j)/8)*2) * 32+ x+((j+(origin))&7)*2)
    //ppu_write_data('.')
    //ppu_write_data(' ')
    //ppu_set_addr(ppu_nametable_ram+$400+word(y+(word(j)/8)*2+1) * 32+ x+((j+(origin))&7)*2)
    //ppu_write_data(' ')
    //ppu_write_data('.')
    socketOwner[origin+j] = 128
    sockets[getRow(y,j)] |= POWS2[7 - (((j+origin)&7))]
  }
  ppu_mask = %00011000
  drawChip('.')
  ppu_wait_vblank()
  ppu_ctrl = %10010000
  return id
}

byte wantedMaxBullets

void drawChip(byte color) {
  ppu_ctrl = %0
  ppu_mask = %0
  byte j
  byte i
  byte dig
  for j,PAUSETOPWALL,until,PAUSEBOTTOMWALL {
    ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL)
    if j&1 > 0 {
      for i,0,until,(PAUSERIGHTWALL-PAUSELEFTWALL)/2 {
        //if socketOwner[((j-PAUSETOPWALL)/2)*8+i] == 128 {
        //if socketOwner[((j-PAUSETOPWALL)/2)*8+i] & 64 > 0 {
        if sockets[(j-PAUSETOPWALL)/2] & POWS2[7-i] > 0 {
          ppu_write_data(' ')
          ppu_write_data(color)
        } else {
          ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL+2+word(i)*2)
        }
      }
    } else {
      for i,0,until,(PAUSERIGHTWALL-PAUSELEFTWALL)/2 {
        //if socketOwner[((j-PAUSETOPWALL)/2)*8+i] == 128 {
        if sockets[(j-PAUSETOPWALL)/2] & POWS2[7-i] > 0 {
          ppu_write_data(color)
          ppu_write_data(' ')
        } else {
          ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL+2+word(i)*2)
        }
      }
    }
  }
  ppu_ctrl = %00000100
}
void debugChip() {
  ppu_ctrl = %0
  ppu_mask = %0
  byte j
  byte i
  byte dig
  for j,PAUSETOPWALL,until,PAUSEBOTTOMWALL {
    ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL)
    if j&1==0  {
      for i,0,until,(PAUSERIGHTWALL-PAUSELEFTWALL)/2 {
        if true {
        //if socketOwner[((j-PAUSETOPWALL)/2)*8+i] == 0 {
        //if sockets[(j-PAUSETOPWALL)/2] & POWS2[7-i] > 0 {
          dig = socketOwner[((j-PAUSETOPWALL)/2)*8+i]
          ppu_write_data('0' + (dig / 100) %% 10)
          ppu_write_data(' ')
          //ppu_write_data(color)
        } else {
          ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL+2+word(i)*2)
        }
      }
    } else {
      for i,0,until,(PAUSERIGHTWALL-PAUSELEFTWALL)/2 {
        if true {
        //if socketOwner[((j-PAUSETOPWALL)/2)*8+i] == 0 {
        //if sockets[(j-PAUSETOPWALL)/2] & POWS2[7-i] > 0 {
          //ppu_write_data(color+1)
          dig = socketOwner[((j-PAUSETOPWALL)/2)*8+i]
          ppu_write_data('0' + (dig / 10) %% 10)
          ppu_write_data('0' + dig %% 10)
          //ppu_write_data(' ')
        } else {
          //ppu_set_addr(ppu_nametable_ram+$400+word(j) * 32+ PAUSELEFTWALL+2+word(i)*2)
        }
      }
    }
  }
  ppu_ctrl = %00000100
}

array sockets [8]
void gamePauseInit() {
  byte i
  array sprsDelete[252] @$200
  i = 0
  while i < 252 {
    sprsDelete[i] = -1
    i+=4
  }
  score2 = prices[selected]
  drawScore()
  ppu_set_scroll(255,0)
}

bool whiteHeart

void gamePauseLogic() {
  ppu_ctrl = %0
  ppu_mask = %0
  whiteHeart = not(whiteHeart)
  if whiteHeart {
    drawHeart(heartX,heartY)
  } else {
    drawHeartBlack(heartX,heartY)
  }
  read_joy1()
  prevA += input_a
  prevA += input_select & timer.lo & 1
  prevB += input_b
  byte i
  byte j
  bool condition
  byte cX
  byte cY
  byte id
  if prevA == %011 {
    if score1 >= prices[selected] {
      cX = (cursorX/8-PAUSELEFTWALL)/2
      cY = (cursorY/8-PAUSETOPWALL)/2
      condition = true
      for i,0,until,socketCellsLengths[selected] {
        j = socketCells[selected][i]
        if (cX+(j&7) >= 8) || (cY+j/8 >= 8) || sockets[cY+j/8] & POWS2[7-cX-(j&7)] == 0 {
          condition = false
          break
        }
      }
      if score1 < selected { condition = false }
      if selected == 0 && heartY != -2 { condition = false }
      if condition {
        placeOnSocket(cX*2+PAUSELEFTWALL,cY*2+PAUSETOPWALL, selected)
        call(socketPut[selected])
        score1 -= prices[selected]
        drawScore()
        rollMaxBullets = wantedMaxBullets
        if rollMaxBullets > TOTALBALLS { rollMaxBullets = TOTALBALLS }
      }
    }
  } else if prevB == %011 {
    cX = (cursorX/8-PAUSELEFTWALL)/2
    cY = (cursorY/8-PAUSETOPWALL)/2
    condition = true

    if sockets[cY] & POWS2[7-cX] == 0
      { condition = false }
    if (cX >= 8) || (cY >= 8)
      { condition = true }
    if not(condition) {
      id = removeFromSocket(cX*2+PAUSELEFTWALL,cY*2+PAUSETOPWALL)
      if id > 0 {
        call(socketPull[id & %111111])
        score1 += prices[id & %111111]
        drawScore()
        rollMaxBullets = wantedMaxBullets
        if rollMaxBullets > TOTALBALLS { rollMaxBullets = TOTALBALLS }
      }
    }
  } else if prevA == %010 {
    if input_select == 0 {
      selected += 1
      if selected >= socketCellsLengths.length {
        selected = 0
      }
      score2 = prices[selected]
      for i,0,until,8 { spr[i].y = -1 }
      drawScore()
    } else {
      drawChip(rand()&7)
    }
  } else if prevB == %010 {
    if selected == 0 {
      selected = socketCellsLengths.length
    }
    selected -= 1
    score2 = prices[selected]
    drawScore()
    for i,0,until,8 { spr[i].y = -1 }
  }
  cX = (cursorX)&(-16)
  cY = (cursorY)&(-16)
  ppu_set_scroll(255,0)
  if timer.lo & 2 > 0
  { cX += 8 }
  if (timer.lo+1) & 2 > 0
  { cY += 8 }
  for i,0,until,socketCellsLengths[selected] {
    j = socketCells[selected][i]
    spr[i].x = cX+(j&%000111)*16
    spr[i].y = cY+(j&%111000)*2
  }
  ppu_set_scroll(255,0)
  ppu_ctrl = %10010000   // enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
  ppu_mask = %00011000   // enable sprites, enable background, no clipping on left side
  if input_start > 0 {
    if pauseCooldown == 0 && heartY != -2 {
      for i,0,until,8 {
        spr[i].y = -1
      }
      pauseCooldown = 1
      gamestate = STATEPLAYING
    }
  } else {
    pauseCooldown = 0
  }
  prevA *= 2
  prevB *= 2
  cursorX += input_dx
  cursorY += input_dy
  rollSpr.head.x = cursorX
  rollSpr.head.tile = $4
  rollSpr.head.attrs = ROLLSPRATTR
  rollSpr.head.y = cursorY

  rollSpr.body1.x = cursorX
  rollSpr.body1.tile = $14
  rollSpr.body1.attrs = ROLLSPRATTR
  rollSpr.body1.y = cursorY+8
}

byte cursorX
byte cursorY
byte selected

void drawPauseMenu() {
  selected = 0
  cursorX = 127
  cursorY = 127
  byte i
  for i,0,until,8 {
    sockets[i] = chipFull[i]
  }
  for i:socketOwner {
    if sockets[i/8] & POWS2[7-(i&7)] > 0 {
      socketOwner[i] = 128
    } else {
      socketOwner[i] = 0
    }
  }

  //draw top boundary
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$420) // point the PPU to the top boundary's start
  for i,0,until,$20 {
    ppu_write_data($1) //write the top boundary tile
  }

  //draw bottom boundary
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$780)
  for i,0,until,$20 {
    ppu_write_data($2) //write the bottom boundary tile
  }

  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$400+word(3)*32+ 5)
  const array scorebackground = "PAUSE MENU"
  for i,0,until,scorebackground.length {
    ppu_write_data(scorebackground[i])
  }

  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$400+word(5) * 32+ 5)
  const array atospend = "PRESS A TO SPEND"
  for i,0,until,atospend.length {
    ppu_write_data(atospend[i])
  }

  //TODO check the functionality of this
  heartX = PAUSELEFTWALL+2
  heartY = PAUSETOPWALL+2

  placeOnSocket(heartX,heartY,0)

  drawChip('.')
  ////LEFT WALL
  //ppu_set_addr(ppu_nametable_ram+$400+word(PAUSETOPWALL) * 32+ PAUSELEFTWALL)
  //for i,0,until,PAUSEBOTTOMWALL-PAUSETOPWALL {
  //  ppu_write_data($81)
  //}

  ////RIGHT WALL
  //ppu_set_addr(ppu_nametable_ram+$400+word(PAUSETOPWALL) * 32+ PAUSERIGHTWALL+1)
  //for i,0,until,PAUSEBOTTOMWALL-PAUSETOPWALL {
  //  ppu_write_data($81)
  //}
  ppu_ctrl = 0
}

void drawHeart(byte x, byte y) {
  ppu_set_addr(ppu_nametable_ram+$400+word(y+1) * 32+ x+1)
  ppu_write_data($1e)
  ppu_write_data($1e)
  ppu_set_addr(ppu_nametable_ram+$400+word(y+2) * 32+ x+1)
  ppu_write_data($84)
  ppu_write_data($85)
}

void drawHeartBlack(byte x, byte y) {
  ppu_set_addr(ppu_nametable_ram+$400+word(y+1) * 32+ x+1)
  ppu_write_data($7f)
  ppu_write_data($7f)
  ppu_set_addr(ppu_nametable_ram+$400+word(y+2) * 32+ x+1)
  ppu_write_data($5c)
  ppu_write_data($2f)
}

void drawHeartContainer(byte x, byte y) {
  ppu_set_addr(ppu_nametable_ram+$400+word(y) * 32+ x)
  //TOP
  ppu_write_data($82)
  ppu_write_data($81)
  ppu_write_data($81)
  ppu_write_data($83)

  //BOTTOM
  ppu_set_addr(ppu_nametable_ram+$400+word(y+3) * 32+ x)
  ppu_write_data($82)
  ppu_write_data($81)
  ppu_write_data($81)
  ppu_write_data($83)

  drawHeart(x,y)

  ppu_ctrl = %00000100
  //MIDDLE
  ppu_set_addr(ppu_nametable_ram+$400+word(y+1) * 32 +x)
  ppu_write_data($83)
  ppu_write_data($83)

  ppu_set_addr(ppu_nametable_ram+$400+word(y+1) * 32 +x+3)
  ppu_write_data($82)
  ppu_write_data($82)
}

