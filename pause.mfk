const array heartSocketCells = [0,1,0+8,1+8]
const array blasterSocketCells = [0,1,2,0+8,1+8]
const array heartSocketTiles = [$82,$81,$83,' ', $81,$83,' ',$82, $83,' ',$82,$81, ' ',$82,$81,$83]
const array blasterSocketTiles = "####################"
const array energySocketTiles = [$82,$81,$83,'E', $81,$83,' ',$82, $83,' ',$82,$81, ' ',$82,$81,$83]
const array energySocketCells = [0,1,0+8,1+8]
const array bubbleWrapCells = [ 0 ]
const array bubbleWrapTiles = [ $09, $09, $09, $09 ]
const array spikesCells = [
    8*0+1,
8*1,8*1+1,8*1+2,
    8*2+1
]
const array spikesTiles = [
     ' ', ' ',
     $18, $18,
' ', $1B,
' ', $1B,
     $08, $08,
