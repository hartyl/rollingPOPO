]
const array Cells2x1 = [ 0,1 ]
const array doubleHeartTiles = [ $11, $3C, $11, $3C, $33, $10, $33, $10 ]
const array gunCells = [
  0*8+0, 0*8+1,
  1*8+0,
  2*8+0
]
