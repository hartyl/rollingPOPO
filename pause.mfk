const array heartSocketCells = [0,1,0+8,1+8]
const array heartSocketTiles = [$82,$81,$83,' ', $81,$83,' ',$82, $83,' ',$82,$81, ' ',$82,$81,$83]
const array heartMissingWarning = "WARNING: NO HEART!"
void heartPut() {
  heartX = (cursorX)/8&(-2)
  heartY = (cursorY)/8&(-2)
  ppu_set_addr(ppu_nametable_ram+$400+32*2+2)
  byte i
  for i:heartMissingWarning {
    ppu_write_data(' ')
  }
}
void heartPull() {
  heartY = -2
  ppu_set_addr(ppu_nametable_ram+$400+word(heartY+1) * 32+ heartX+1)
  ppu_write_data('.')
  ppu_write_data(' ')
  ppu_set_addr(ppu_nametable_ram+$400+word(heartY+2) * 32+ heartX+1)
  ppu_write_data(' ')
  ppu_write_data('.')
  ppu_set_addr(ppu_nametable_ram+$400+32*2+2)
  byte i
  for i,0,until,heartMissingWarning.length {
    ppu_write_data(heartMissingWarning[i])
  }
}

