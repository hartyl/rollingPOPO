// Taken from Nerdy Nights Week 7's pong example game
// (http://nintendoage.com/forum/messageview.cfm?catid=22&threadid=8747)
//
// Original example made by bunnyboy of nintendoage.com
// Millfork adaptation by Garydos (https://github.com/Garydos)
//
// compile with -t nes_small

import random
import nes_joy
import famitone5

// *STRUCT DEFINTIONS*

import sprite
import pause

struct playerSpr {
  Sprite arm1,
  Sprite foot1,
  Sprite head,
  Sprite body1,
  Sprite body2,
  Sprite ribbon1,
  Sprite ribbon2,
  Sprite ponytail,
  Sprite foot2,
  Sprite arm2
}

// *CONSTANTS*

const byte TOTALBALLS = 22 //TODO this is maybe too much
const byte TOTALENEMIES = 8
const byte ENEMYTIMER = 120
const byte ENEMYSPEED = 2

enum Gamestate {
  STATETITLE,    // displaying title screen
  STATEPLAYING,  // move paddles/ball, check for collisions
  STATEGAMEOVER, // displaying game over screen
  STATEPAUSE    // displaying pause screen
  //STATESKILL,    // displaying skilltree
  //STATECHIP,     // displaying chip editor
  //STATECHIPBUY   // displaying chip selector
}

const byte RIGHTWALL   = $F4  // when ball reaches one of these, do something
const byte TOPWALL     = $18
const byte BOTTOMWALL  = $E0
const byte LEFTWALL    = $04

const byte ROLL2X    = $F0

const byte ROLLHEIGHT   = $18  // height of each paddle in pixels

// sprite tiles used by the paddles
const byte ROLLRIBBONSPR   = 01
const byte ROLLTOPBOTSPR = 02
const byte ROLLPONYTAILSPR = 17
const byte ROLLBODYSPR   = 18
const byte ROLLARMSPR    = 19
const byte ROLLBODY2SPR  = 34
const byte ROLLFOOT1SPR  = 49
const byte ROLLFOOT2SPR  = 51

// sprite attributes used by the paddles
const byte ROLLSPRATTR = $01
const byte ROLLSPRATTRHFLIP = $41
const byte ROLLSPRATTRVFLIP = $81
const byte ROLLSPRATTRHVFLIP = $C1

// sprite tiles and attributes used by the ball
const byte BALLSPRATTR = $01
const byte BALLSPR = $34
const byte ENEMYSPR = $02
const byte gravity = 0

// vram locations declared as constants for readability/convenience
// *note that these do not correlate to CPU ram locations*
const word ppu_pallete_ram = $3F00
const word ppu_nametable_ram = $2000
const word ppu_nametable_0_attr_ram = $23C0

const array(byte) POWS2 = for i,0,until,8 [ 1<<i ]

//xlo
const byte bulletDmgX        = %000001
const byte bulletBigX        = %001000
const byte enemyIsFollowX    = %100000
//ylo
const byte ballBounceY       = %000001
const byte bulletPierceY     = %000100
const byte bulletPushY       = %010000
const byte bulletDecelerateY = %100000
import ball

// *VARIABLES*

word rollx
word rolly
word rollSpdx
word rollSpdy
byte rollSpd
byte rollMaxSpeed
byte rollDef
bool rollRight
byte rollHP
byte rollMaxBullets
byte rollCooldown
byte currentBullet

byte cooldownShotgun
byte cooldown
word modifier
sbyte shatx
sbyte shaty
byte bubbleBuffer

byte difficulty

byte pauseCooldown

//byte paddle2ytop   // player 2 paddle bottom vertical position
byte score1   // player 1 score, 0-15
byte score2   // player 2 score, 0-15
array oam_buffer [256] @$200 // sprite buffer

playerSpr rollSpr @$200 //  left paddle's sprites
Sprite ball_spr1 @rollSpr.addr+sizeof(rollSpr)   //  ball's sprite

//playerSpr right_paddle_sprs @ball_spr1.addr + TOTALBALLS*sizeof(ball_spr1) // right paddle's sprites
//Sprite enemy_spr0 @right_paddle_sprs.addr + sizeof(right_paddle_sprs)
Sprite enemy_spr0 @ball_spr1.addr + TOTALBALLS*sizeof(ball_spr1)

word timer   // counts the amount of frames that have passed

array(Ball) bls [TOTALBALLS] align(fast)
byte bulletCount

array(Ball) enms [TOTALENEMIES] align(fast)

//TODO
array(byte) spares [(BOTTOMWALL/8)*4]//[((RIGHTWALL-LEFTWALL)/8)*((BOTTOMWALL-TOPWALL)/8)]

volatile Gamestate gamestate // the current Gamestate

bool sprUpdateUpwards
byte bulletSpeedDivider
byte bulletSpeedAdder

byte destroyedEnemies

byte playerInvisible

void main() {
  //set up the music
  FamiToneInit(1, nesthing_ost.addr)
  FamiToneSfxInit(twin_dragons_sfx.addr)

  bulletSpeedAdder = 6
  bulletSpeedDivider = 1
  sprUpdateUpwards = true
  //Set starting game state
  gamestate = STATETITLE
  //prepare the title screen gamestate
  game_title_init()
  while(true){} // all work is done in NMI
}

void nmi() {

  timer += 1
  //Push sprite information to the PPU through DMA transfer
  ppu_oam_dma_write(oam_buffer.addr.hi)
  ppu_set_addr(ppu_pallete_ram+16+4+2) // point the PPU to palette ram
  if timer.lo & 1 > 0 {
    ppu_write_data($36)
  } else {
    ppu_write_data($27)
  }
  ppu_set_addr(0)

  //Run graphics updates + game logic specific to each gamestate
  main_game_logic()
  //TODO do something with this
  FamiToneUpdate()
  if timer.lo & 0 == 0 {
  }
}

void irq() { }

inline void main_game_logic() {
  // use a return dispatch here
  // to use different logic for each screen/gamestate
  return [gamestate] {
    STATETITLE  @ game_title_logic
    STATEPLAYING  @ gamePlayingLogic
    STATEGAMEOVER @ game_gameover_logic
    STATEPAUSE @ gamePauseLogic
    //STATESKILL @ gameSkilltreeLogic
    //STATECHIP  @ gameChipEditorLogic
    //STATECHIPBUY @ gameChipSelectorLogic
  }
}

void game_title_init() {
  //FamiToneMusicPlay($00)
  FamiToneSfxPlay(0,FT_SFX_CH0)
  byte i
  //for now, turn off the screen and nmi
  ppu_ctrl = 0
  ppu_mask = 0

  //initialize the sprites and palletes
  init_graphics()

  //write a full screen of background data

  load_sky_background()

  //write the title screen message
  read_ppu_status() // read PPU status to reset the high/low latch
  const array title_msg0 = "Roll Joins the POPO"
  ppu_set_addr(ppu_nametable_ram+word(32)*10+(33-title_msg0.length)/2) // point the PPU to the message's start
  for i,0,until,title_msg0.length {
    ppu_write_data(title_msg0[i])
  }
  const array title_msg = "PRESS START"
  ppu_set_addr(ppu_nametable_ram+word(32)*12+(33-title_msg.length)/2) // point the PPU to the message's start
  for i,0,until,title_msg.length {
    ppu_write_data(title_msg[i])
  }

  const array title_msg2 = "(I don't own a house)"
  ppu_set_addr(ppu_nametable_ram+word(18)*32+(33-title_msg2.length)/2) // point the PPU to the message's start
  for i,0,until,title_msg2.length {
    ppu_write_data(title_msg2[i])
  }
  const array title_msg3 = "(much less Roll or megaman)"
  ppu_set_addr(ppu_nametable_ram+word(19)*32+(33-title_msg3.length)/2) // point the PPU to the message's start
  for i,0,until,title_msg3.length {
    ppu_write_data(title_msg3[i])
  }

  const array title_msg4 = "fangame by Hartyl"
  ppu_set_addr(ppu_nametable_ram+word(23)*32+(33-title_msg4.length)/2) // point the PPU to the message's start
  for i,0,until,title_msg4.length {
    ppu_write_data(title_msg4[i])
  }

  //write the border
  //top border
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$0020)
  for i,0,until,$20 {
    ppu_write_data($01)
  }
  //bottom border
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$0380)
  for i,0,until,$20 {
    ppu_write_data($01)
  }

  //set ppu address increment to 32 so we can draw the left and right borders
  //(allows us to draw to the nametable in vertical strips rather than horizontal)
  ppu_ctrl = %00000100

  //left border
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+1)
  for i,0,until,$20 {
    ppu_write_data($01)
  }
  //right border
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$1F)
  for i,0,until,$20 {
    ppu_write_data($01)
  }

  timer = 0
  ppu_set_scroll(0,0)
  ppu_wait_vblank() //wait for next vblank before re-enabling NMI
                    //so that we don't get messed up scroll registers
                    //re-enable the screen and nmi
  ppu_ctrl = %10010000   // enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
  ppu_mask = %00011000   // enable sprites, enable background, no clipping on left side
}

void game_title_logic() {
  read_joy1()
  if input_start != 0 {
    pauseCooldown = 1
    rand_seed = timer //seed the random number generator with the amount of frames
                      //that have passed since the title screen was shown
    gamestate = STATEPLAYING
    gamePlayingInit()
    return
  }
}

inline asm void ppu_wait_vblank() {
vblankwait:
  BIT $2002
    ! BPL vblankwait
    ? RTS
}

const byte bulletSkip = 4

byte enemyCount
byte enemyTimer
byte maxEnemiesAtOnce
byte sorterI
byte bulletTurn
byte bulletBuffer
byte bulletShotgun
byte ballBounce
bool bulletPierce
bool bulletPush
bool bulletDecelerate
byte rollThorns
byte pierceAnyways
byte rollRegen
byte rollMaxHp
byte cooldownSkipped
byte rollCooldown2

void gamePlayingInit() {
  score1 = 255
  rollMaxSpeed = 1
  rollSpd = 20
  bubbleBuffer = 0
  rollDef = 0
  FamiToneMusicStop()
  //FamiToneSfxPlay(3,FT_SFX_CH0)
  //FamiToneMusicPlay(0)

  wantedMaxBullets = 1
  cooldownSkipped = 0
  cooldownShotgun = 0
  sorterI = 0
  bulletTurn = 2
  playerInvisible = 100
  rollMaxHp = 10
  rollHP = rollMaxHp
  rollMaxBullets = 1
  destroyedEnemies = 0
  difficulty = 0
  maxEnemiesAtOnce = 3
  bulletBuffer = 0
  bulletShotgun = 1
  ballBounce = 0
  rollCooldown = 30
  rollCooldown2 = 128
  bulletPierce = false
  bulletPush = true
  bulletDecelerate = true
  rollThorns = 0
  pierceAnyways = 0
  currentBullet = 0
  rollRegen = 0
  ppu_set_addr(ppu_pallete_ram) // point the PPU to palette ram
  ppu_write_data(pallete[0])

  byte i
  array ball_spr[TOTALBALLS*4] @ball_spr1.addr
  i=0
  while i<TOTALBALLS {
    ball_spr[i*4+0] = -1
    ball_spr[i*4+1] = BALLSPR
    ball_spr[i*4+2] = BALLSPRATTR
    i+=1
  }
  array enm_spr [1]@enemy_spr0.addr
  i=0
  while i<TOTALENEMIES {
    enm_spr[i*4+0] = -1
    enm_spr[i*4+1] = ENEMYSPR
    //enm_spr[i*4+2] = BALLSPRATTR
    i+=1
  }
  i=0
  while i<spares.length {
    spares[i]=0
    i+=1
  }

  enemyCount = 0
  enemyTimer = 0
  bulletCount = 0
  //for now, turn off the screen and nmi
  ppu_ctrl = 0
  ppu_mask = 0

  //write a full screen of data
  load_sky_background()
  draw_score_text_background()
  draw_boundaries_background()
  load_play_attribute_table()

  drawPauseMenu()
  gamePauseCreate()

  //initialize the game
  game_init()

  ppu_set_scroll(0,0)
  ppu_wait_vblank() //wait for next vblank before re-enabling NMI
                    //so that we don't get messed up scroll registers
                    //re-enable the screen and nmi
  ppu_ctrl = %10010000   // enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
  ppu_mask = %00011000   // enable sprites, enable background, no clipping on left side
}

void printAtPosition(byte x, byte y, byte tile) {
  byte xx
  byte yy
  read_ppu_status()
  yy = y/8
  xx = x/8
  ppu_set_addr(ppu_nametable_ram+word(yy)*32+xx)
  ppu_write_data(tile)
}

byte getSpareIndex(byte x, byte y) {
  byte XX
  if x < 128 {
    if x < 64 {
      XX = 0
    } else {
      XX = 1
    }
  } else {
    if x < 128+64 {
      XX = 2
    } else {
      XX = 3
    }
  }
  return XX+((y/2)&(-4))
}

void gamePlayingLogic() {
  score2 = rollHP
  //score2 = currentBullet
  drawScore()

  //printAtPosition(balls[0]->x.hi,balls[0]->y.hi)

  byte xx
  xx = POWS2[((rollx.hi+4)/8) & 7]
  byte index
  index = getSpareIndex(rollx.hi+4,rolly.hi+8)
  byte r
  if spares[index] & xx != 0 {
    xx ^= -1
    spares[index] &= xx
    printAtPosition(rollx.hi+4,rolly.hi+8,' ')
    r = rand() & %11111
    if score1 < 255 {
      score1 += 1
    } else {r/=2}
    if rollHP < rollMaxHp && r < rollRegen {
      rollHP += 1
    }
  }

  pointer.Ball dedEnemy
  while destroyedEnemies > 0 {
    dedEnemy = enms[enemyCount+destroyedEnemies-1].pointer
    printAtPosition(dedEnemy->x.hi,dedEnemy->y.hi,rand()/4+2)

    index = getSpareIndex(dedEnemy->x.hi, dedEnemy->y.hi)
    xx = POWS2[(dedEnemy->x.hi/8) & 7]
    spares[index] |= xx
    destroyedEnemies -= 1
  }
  byte dir
  pointer.Ball enm
  array enmSpr [128]@enemy_spr0.addr
  if enemyCount < maxEnemiesAtOnce {
    enemyTimer += 1
    if enemyTimer > ENEMYTIMER {
      enm = enms[enemyCount].pointer
      //printAtPosition(enm->x.hi,enm->y.hi,0)
      dir = rand()
      if dir & 2 == 2 {
        if dir & 1 == 1
          {shootBall(enm, LEFTWALL, TOPWALL + dir/2+dir/4, 2, 0)}
        else
          {shootBall(enm, RIGHTWALL-8, TOPWALL + dir/2+dir/4,-2, 0)}
      } else {
        if dir & 1 == 1
          {shootBall(enm, dir,TOPWALL+1,        0, 2)}
        else
          {shootBall(enm, dir,BOTTOMWALL - 8 -1, 0,-2)}
      }
      enm->x.lo = 0
      enm->y.lo = 0
      // TODO make this a progressive thing
      // maybe with constant tables
      if rand() < 200-difficulty {
        //enemy 1
        if rand()>180  {
          enm->x.lo = 4 //HP
          if enm->speedx < 0 {
            enm->speedx /= 2
            enm->speedx |= 128
          } else {
            enm->speedx /= 2
          }
          if enm->speedy < 0 {
            enm->speedy /= 2
            enm->speedy |= 128
          } else {
            enm->speedy /= 2
          }
          enmSpr[(0+enemyCount*4)*4+1] = $0B
          enmSpr[(1+enemyCount*4)*4+1] = $0C
          enmSpr[(2+enemyCount*4)*4+1] = $1B
          enmSpr[(3+enemyCount*4)*4+1] = $1C
          enmSpr[(0+enemyCount*4)*4+2] = %00000000
          enmSpr[(1+enemyCount*4)*4+2] = %00000000
          enmSpr[(2+enemyCount*4)*4+2] = %00000000
          enmSpr[(3+enemyCount*4)*4+2] = %00000000
        } else {
          enm->x.lo = 2 //HP
          enmSpr[(0+enemyCount*4)*4+1] = $05
          enmSpr[(1+enemyCount*4)*4+1] = $24
          enmSpr[(2+enemyCount*4)*4+1] = $15
          enmSpr[(3+enemyCount*4)*4+1] = $16
          enmSpr[(0+enemyCount*4)*4+2] = %00000000
          enmSpr[(1+enemyCount*4)*4+2] = %00000000
          enmSpr[(2+enemyCount*4)*4+2] = %00000000
          enmSpr[(3+enemyCount*4)*4+2] = %00000000
        }
      } else {
        //bouncy enemy
        if difficulty > 5 && rand()>150-difficulty {
          enm->x.lo = 2 //HP
          enm->y.lo |= 3 //bounces
          enmSpr[(0+enemyCount*4)*4+1] = $07
          enmSpr[(1+enemyCount*4)*4+1] = $24
          enmSpr[(2+enemyCount*4)*4+1] = $17
          enmSpr[(3+enemyCount*4)*4+1] = $18
          enmSpr[(0+enemyCount*4)*4+2] = %00000000
          enmSpr[(1+enemyCount*4)*4+2] = %00000000
          enmSpr[(2+enemyCount*4)*4+2] = %00000000
          enmSpr[(3+enemyCount*4)*4+2] = %00000000
        } else {
          enm->x.lo = 0 //HP
          enmSpr[(0+enemyCount*4)*4+1] = $09
          enmSpr[(1+enemyCount*4)*4+1] = $24
          enmSpr[(2+enemyCount*4)*4+1] = $19
          enmSpr[(3+enemyCount*4)*4+1] = $1A
          enmSpr[(0+enemyCount*4)*4+2] = %00000000
          enmSpr[(1+enemyCount*4)*4+2] = %00000000
          enmSpr[(2+enemyCount*4)*4+2] = %00000000
          enmSpr[(3+enemyCount*4)*4+2] = %01000000
        }
        enm->x.lo |= enemyIsFollowX //isFollowy
      }
      //TODO undo this
      if rand() > 20-difficulty {
        enm->y.lo |= bulletDecelerateY
        //enmSpr[enemyCount*4*4+1] += $20
        //enmSpr[enemyCount*4*4+1+4] += $20
        //enmSpr[enemyCount*4*4+1+8] += $20
        //enmSpr[enemyCount*4*4+1+12] += $20
      }
//          enmSpr[(0+enemyCount*4)*4+1] = $0B
//          enmSpr[(1+enemyCount*4)*4+1] = $0C
//          enmSpr[(2+enemyCount*4)*4+1] = $1B
//          enmSpr[(3+enemyCount*4)*4+1] = $1C
          //enmSpr[(0+enemyCount*4)*4+1] = $07
          //enmSpr[(1+enemyCount*4)*4+1] = $24
          //enmSpr[(2+enemyCount*4)*4+1] = $17
          //enmSpr[(3+enemyCount*4)*4+1] = $18
          //enmSpr[(0+enemyCount*4)*4+1] = $05
          //enmSpr[(1+enemyCount*4)*4+1] = $24
          //enmSpr[(2+enemyCount*4)*4+1] = $15
          //enmSpr[(3+enemyCount*4)*4+1] = $16
          //enmSpr[(0+enemyCount*4)*4+1] = $09
          //enmSpr[(1+enemyCount*4)*4+1] = $24
          //enmSpr[(2+enemyCount*4)*4+1] = $19
          //enmSpr[(3+enemyCount*4)*4+1] = $1a
          //enmSpr[(3+enemyCount*4)*4+2] ^= %01000000
      enemyTimer = 1
      enemyCount += 1
    }
  }

  // end drawing graphics
  ppu_set_scroll(0,0)
  ppu_ctrl = %10010000
  ppu_mask = %00011000

  movePlayer()

  updateSprites()
  if input_start > 0 {
    if pauseCooldown == 0 {
      pauseCooldown = 1
      gamestate = STATEPAUSE
      gamePauseInit()
    }
  } else {
    pauseCooldown = 0
  }

  i = 0
  array ballSpr [TOTALBALLS*4] @ball_spr1.addr
  bool active
  while i<bulletCount {
    active = moveBall(bls[i].pointer)
    if active == false {
      bulletCount -= 1
      bls[i] = bls[bulletCount]
      ballSpr[4*bulletCount] = -1
    } else {
      i += 1
    }
  }
  byte prevSorterI
  byte swap
  word wswap
  if bulletCount>1 {
    if sorterI-1 >= bulletCount-1 {
      sorterI = bulletCount-1
    }
    prevSorterI = sorterI
    sorterI -= 1
    if bls[prevSorterI].x.hi > bls[sorterI].x.hi {
      wswap = bls[prevSorterI].x
      bls[prevSorterI].x = bls[sorterI].x
      bls[sorterI].x = wswap

      wswap = bls[prevSorterI].y
      bls[prevSorterI].y = bls[sorterI].y
      bls[sorterI].y = wswap

      swap = bls[prevSorterI].speedx
      bls[prevSorterI].speedx = bls[sorterI].speedx
      bls[sorterI].speedx = swap

      swap = bls[prevSorterI].speedy
      bls[prevSorterI].speedy = bls[sorterI].speedy
      bls[sorterI].speedy = swap
    }
  }

  byte i
  byte b
  byte x
  byte y

  byte fin
  i = enemyCount
  array spr [TOTALENEMIES*4] @enemy_spr0.addr
  bool enmActive
  while i>0 {
    i-=1
    enm = enms[i].pointer
    if isFollowy(enm) {
      enmActive = true
      moveBall(enm)
      // accelerates faster when:
      if ((isBouncy(enm)) && timer.lo & %1111 < 3) || timer.lo & %111 == 0 {
        if enm->x.hi > rollx.hi {
          if enm->speedx > -8 {
            enm->speedx -= 1
          }
        } else {
          if enm->speedx < 8 {
            enm->speedx += 1
          }
        }
        if enm->y.hi > rolly.hi {
          if enm->speedy > -8 {
            enm->speedy -= 1
          }
        } else {
          if enm->speedy < 8 {
            enm->speedy += 1
          }
        }
      }
    } else {
      enmActive = moveBall(enm)
    }
    if isSlow(enm) {
      enmActive = true
      //TODO this is wrong
      if (spr[i*4+1] == $18 && timer.lo & %11111110 < 3) || (spr[i*4+1] != $18 && timer.lo & %1111110 < 2) {
        if enm->speedx > -64 && enm->speedx < 64 {
          enm->speedx *= 4
        }
        if enm->speedy > -64 && enm->speedy < 64 {
          enm->speedy *= 4
        }
      }
    }

    if isBouncy(enm) {
      enmActive = true
      enm->y |= 3
    }
    b = bulletTurn
    fin = bulletTurn + bulletSkip
    if fin > bulletCount {fin = bulletCount}
    while b < fin {
      if enm->x.hi > bls[b].x.hi-12 {
        if enm->x.hi < bls[b].x.hi+12 {
          y = enm->y.hi - bls[b].y.hi
          if y+12 < 20 {
            if enm->y.lo & bulletPierceY==0 {
              //damage enemy
              if bls[b].y.lo & %1100 <= %100 { //dont damage if its still pearcing
                if getHP(enm) >= getHP(bls[b].pointer) {
                  setHP(enm, getHP(enm) - getHP(bls[b].pointer))
                  if bls[b].y.lo & bulletPushY > 0 {
                    if bls[b].speedx < 0 {
                      enm->speedx += bls[b].speedx/4 | (128 | 64)
                    } else {
                      enm->speedx += bls[b].speedx/4
                    }
                    if bls[b].speedy < 0 {
                      enm->speedy += bls[b].speedy/4 | (128 | 64)
                    } else {
                      enm->speedy += bls[b].speedy/4
                    }
                  }
                } else {
                  enmActive = false
                  destroyedEnemies += 1
                  difficulty += 1
                  maxEnemiesAtOnce = difficulty/16+3
                  if maxEnemiesAtOnce > TOTALENEMIES
                    {maxEnemiesAtOnce = TOTALENEMIES}
                  maxEnemiesAtOnce = TOTALENEMIES
                }
              }
              //destroy bullet
              //unless the enm is invincible
            } else {
              if bls[b].y.lo & 3 == 0 {
                bls[b].y.lo |= 1 | bulletDecelerateY
                bls[b].speedx *= 2
                bls[b].speedy *= 2
              }
            }
            if bls[b].y.lo & (bulletPierceY | (bulletPierceY*2) | 3) == 0 {
              //destroy unless it bounces or pierces
              bulletCount -= 1
              bls[b] = bls[bulletCount]
              ballSpr[bulletCount<<2] = -1
            } else {
              //bounce
              if bls[b].y.lo & (bulletPierceY *%11) > 0 {
                bls[b].y.lo |= bulletPierceY * %11
              }
              if bls[b].y.lo & %11 > 0 {
                //sub one bounce if weak bounce
                if bls[b].y.lo & %11 < %10 {
                  //bls[b].y.lo -= 1
                }
                if bls[b].x.hi+bls[b].y.hi > enm->x.hi+enm->y.hi {
                  if bls[b].x.hi-bls[b].y.hi < enm->x.hi-enm->y.hi {
                    if bls[b].speedy < 0 {
                      bls[b].speedy = -bls[b].speedy
                    }
                    bls[b].y.hi = enm->y.hi+12
                  } else {
                    if bls[b].speedx < 0 {
                      bls[b].speedx = -bls[b].speedx
                    }
                    bls[b].x.hi = enm->x.hi+12
                  }
                } else {
                  if bls[b].x.hi-bls[b].y.hi < enm->x.hi-enm->y.hi {
                    if bls[b].speedx > 0 {
                      bls[b].speedx = -bls[b].speedx
                    }
                    bls[b].x.hi = enm->x.hi-12
                  } else {
                    if bls[b].speedy > 0 {
                      bls[b].speedy = -bls[b].speedy
                    }
                    bls[b].y.hi = enm->y.hi-12
                  }
                }
              }
            }
            break;
          }
        } else {break}
      }
      b += 1
    }

    if playerInvisible <= 1 {
      x = enm->x.hi - rollx.hi
      if x+8 < 16 {
        y = enm->y.hi - rolly.hi
        if y+8 < 16 {
          playerInvisible = 100
          rollHP -= 1
          if rollHP == -1 {
            gameoverInit()
          }
          FamiToneSfxPlay(5,FT_SFX_CH0)
          if enm->x.lo & $111 >= rollThorns {
            enm->x.lo -= rollThorns
          } else {
            enmActive = false
          }
        }
      }
    }
    if enmActive == false {
      enemyCount -= 1
      swap = enms[i].x.hi
      enms[i].x.hi = enms[enemyCount].x.hi
      enms[enemyCount].x.hi = swap

      swap = enms[i].y.hi
      enms[i].y.hi = enms[enemyCount].y.hi
      enms[enemyCount].y.hi = swap

      enms[i].speedx = enms[enemyCount].speedx
      enms[i].speedy = enms[enemyCount].speedy
      enmSpr[i*4*4+1] = enmSpr[enemyCount*4*4+1]
      enmSpr[i*4*4+2] = enmSpr[enemyCount*4*4+2]
      enmSpr[i*4*4+1+4] = enmSpr[enemyCount*4*4+1+4]
      enmSpr[i*4*4+2+4] = enmSpr[enemyCount*4*4+2+4]
      enmSpr[i*4*4+1+8] = enmSpr[enemyCount*4*4+1+8]
      enmSpr[i*4*4+2+8] = enmSpr[enemyCount*4*4+2+8]
      enmSpr[i*4*4+1+12] = enmSpr[enemyCount*4*4+1+12]
      enmSpr[i*4*4+2+12] = enmSpr[enemyCount*4*4+2+12]

      enms[i].x.lo = enms[enemyCount].x.lo
      enms[i].y.lo = enms[enemyCount].y.lo
      //swap = enms[i].HP
      //enms[i].HP = enms[enemyCount].HP
      //enms[enemyCount].HP = swap
      //spr[enemyCount*4*4] = -1
      enmSpr[enemyCount*4*4] = -1
      enmSpr[enemyCount*4*4+4] = -1
      enmSpr[enemyCount*4*4+8] = -1
      enmSpr[enemyCount*4*4+12] = -1
    }
  }
  bulletTurn += bulletSkip
  if bulletTurn > bulletCount-1 {
    bulletTurn = 0
  }

  //score2 = bulletCount
  //score2 = rollMaxBullets

  //ppu_mask = 0
  //ppu_set_addr(ppu_pallete_ram) // point the PPU to palette ram
  //ppu_write_data(" ")
  //ppu_mask = %00011000
  //sprite0Hit = false
  //while ppu_status & 4 == 0 { if ppu_status < 0 {return} }
  //sprite0Hit = true
}

void gameoverInit() {
  //for now, turn off nmi and sprites
  gamestate = STATEGAMEOVER
  array sprsDelete[252] @$200
  byte i
  i = 0
  while i < 252 {
    sprsDelete[i] = -1
    i+=4
  }
  ppu_ctrl = 0
  ppu_mask = 0

  drawScore() //draw the final score
  draw_game_over_screen() //draw the game over message

  timer = 0
  ppu_set_scroll(0,0)  // tell the ppu there is no background scrolling
  ppu_wait_vblank() //wait for next vblank before re-enabling NMI
                    //so that we don't get messed up scroll registers
                    //re-enable the screen and nmi
  ppu_ctrl = %10010000   // enable NMI, sprites from Pattern Table 0, background from Pattern Table 1
  ppu_mask = %00011000   // enable sprites, enable background, no clipping on left side
}

void game_gameover_logic() {
  if timer >= 240{
    //3 seconds have passed,
    //reset the game
    simulate_reset()
  }
}
void movePlayer() {
  // Player 1 controls
  //if timer.lo&7>0 {return}
  read_joy1()
  if input_dy < 0 {  // Up button
    //TODO weird drift
    if rollSpdy.hi >= -rollMaxSpeed || rollSpdy.hi < 128 {
      rollSpdy -= rollSpd
    }
  } else if input_dy > 0 { // Down button
    if rollSpdy.hi < rollMaxSpeed || rollSpdy.hi > 127 {
      rollSpdy += rollSpd
    }
  } else {
    //stop
    if rollSpdy.hi < 1 {
      rollSpdy = 0
    } else if rollSpdy.hi < 127 {
      rollSpdy -= rollSpd
    } else if rollSpdy.hi <= -1 {
      rollSpdy += rollSpd
    } else {
      rollSpdy = 0
    }
  }
  if input_dx > 0 {
    if rollx.hi < RIGHTWALL-8 {
      if rollSpdx.hi < rollMaxSpeed || rollSpdx.hi > 127 {
        rollSpdx += rollSpd
      }
      rollRight = true
    }
  } else if input_dx < 0 {
    if rollx.hi > LEFTWALL {
      //TODO too
      if rollSpdx.hi >= -rollMaxSpeed || rollSpdx.hi < 128 {
        rollSpdx -= rollSpd
      }
      rollRight = false
    }
  } else {
    if rollSpdx.hi < 1 {
      rollSpdx = 0
    } else if rollSpdx.hi < 127 {
      rollSpdx -= rollSpd
    } else if rollSpdx.hi <= -1 {
        rollSpdx += rollSpd
    } else {
      rollSpdx = 0
    }
  }
  if rolly.hi > TOPWALL && rolly.hi+8 < BOTTOMWALL {
    rolly += rollSpdy
  } else {
    rollSpdy = 0
    rolly.lo = 0
    if rolly.hi < BOTTOMWALL {
      rolly.hi = TOPWALL+1
    } else {
      rolly.hi = BOTTOMWALL-1-8
    }
  }
  if rollx.hi > LEFTWALL && rollx.hi+8 < RIGHTWALL {
    rollx += rollSpdx
  } else {
    rollSpdx = 0
    rollx.lo = 0
    if rollx.hi < RIGHTWALL-8 {
      rollx.hi = LEFTWALL + 1
    } else {
      rollx.hi = RIGHTWALL -8 - 1
    }
  }
  byte pA
  byte shatD
  pointer.Ball poinBall
  bool shat
  prevA += input_a
  prevB += input_b
  if cooldownShotgun > 0 {
    cooldownShotgun -= 1
  }
  if cooldown > 0 {
    cooldown -= 1
    if cooldown == 0 {
      cooldownSkipped = 0
    } else {
      if (prevA | prevB) & 15 == 0 {
        cooldownSkipped = cooldown
        cooldown = 0
      }
    }
  } else if bulletCount < rollMaxBullets {
    if bulletBuffer == 0 {
      pA = prevA & 7
      shatx = 0
      shaty = 0
      shat = false
      modifier = 0
      if pA == %111 {
        shatx = rollSpdx.hi+bulletSpeedAdder
        shaty = rollSpdy.hi+bulletSpeedAdder
        shat = true
      } else if pA == %010 {
        shatx = rollSpdx.hi+bulletSpeedAdder
        shaty = rollSpdy.hi-bulletSpeedAdder
        shat = true
      }
      pA = prevB & %111
      if pA == %111 {
        shatx = rollSpdx.hi-bulletSpeedAdder
        shaty = rollSpdy.hi+bulletSpeedAdder
        shat = true
      } else if pA == %010 {
        shatx = rollSpdx.hi-bulletSpeedAdder
        shaty = rollSpdy.hi-bulletSpeedAdder
        shat = true
      }
      if shat {
        if cooldownSkipped > 0 || bulletCount+bulletShotgun >= rollMaxBullets-1 {
          // default
          // slow
          if bulletShotgun > 1 {
            if cooldownShotgun == 0 { //try shotgun
              currentBullet = 2
              cooldownShotgun = rollCooldown2
            } else if bulletCount >= rollMaxBullets-1 {
              currentBullet = 0
            } else {
              currentBullet = 1
            }
          } else if bulletCount >= rollMaxBullets-1 {
            //no bullets left
            currentBullet = 0
          } else {
            currentBullet = 1
          }
        } else { //remaining bullets
          currentBullet = 1
        }
        if currentBullet == 0 { //punch
          bulletBuffer = 1
          modifier.lo = 1
          modifier.hi = 1 | bulletPushY | bulletDecelerateY
          //FamiToneSfxPlay(10,FT_SFX_CH0)
          //FamiToneSfxPlay(15,FT_SFX_CH0)
          //FamiToneSfxPlay(16,FT_SFX_CH0)// electroshock
          //FamiToneSfxPlay(18,FT_SFX_CH0) //annoying
          FamiToneSfxPlay(19,FT_SFX_CH0) //punch
          //FamiToneSfxPlay(0,FT_SFX_CH0)
          //FamiToneMusicPlay(0)
        } else if currentBullet == 1 { //bullet
          if bulletCount < rollMaxBullets {
            bulletBuffer = 1
            modifier.lo = 1
            modifier.hi = 0
          }
          FamiToneSfxPlay(10,FT_SFX_CH0)
        } else if currentBullet == 2 { //shotgun
          shatx *= 2
          shaty *= 2
          bulletBuffer = bulletShotgun
          if bulletBuffer+bulletCount >= TOTALBALLS-1 {
            if rollMaxBullets > bulletCount-1
              { bulletBuffer = TOTALBALLS - bulletCount-1 }
            else
              { bulletBuffer = 0 }
          }
          modifier.lo = 1
          modifier.hi = bulletDecelerateY
          FamiToneSfxPlay(12,FT_SFX_CH0)
        } else if currentBullet == 3 { //superPunch
          shatx *= 2
          shaty *= 2
          bulletBuffer = 1
          modifier.lo = (bulletDmgX*3) | bulletBigX | bulletBigX
          modifier.hi = bulletDecelerateY | bulletPierceY | bulletPushY
        } else if currentBullet == 4 { //bullet
          if bulletCount < rollMaxBullets {
            bulletBuffer = 1
            modifier.lo = 1 | bulletBigX
            modifier.hi = 0
          }
        }
      }
    }
    if bulletBuffer > 0 {
      poinBall = bls[bulletCount].pointer
      shootBall(poinBall, rollx.hi, rolly.hi, shatx, shaty)
      bulletCount += 1
      bulletBuffer -= 1
      poinBall->x.lo = modifier.lo
      poinBall->y.lo = modifier.hi
      if rand() < pierceAnyways {
        poinBall->y.lo |= bulletPierceY
      }
      if modifier.hi & bulletDecelerateY > 0 {
        poinBall->speedx *= 2
        poinBall->speedy *= 2
      }
      if currentBullet == 2 {
        shatD = (rand() & %111) - %11
        if shatx > 0 {
          shatx += shatD
          if shatx <= 0 {
            shatx = -shatx
          }
        } else {
          shatx += shatD
          if shatx > 0 {
            shatx = -shatx
          }
        }
        shatD = (rand() & %111) - %11
        if shaty > 0 {
          shaty += shatD
          if shaty <= 0 {
            shaty = -shaty
          }
        } else {
          shaty += shatD
          if shaty > 0 {
            shaty = -shaty
          }
        }
      }
      if bulletBuffer == 0 {
        if bubbleBuffer & 128 == 0 {
          cooldown = rollCooldown
          if bubbleBuffer > 0 {
            bubbleBuffer |= %10000000
          }
        } else {
          bulletBuffer = bubbleBuffer & %01111111
          bubbleBuffer &= %01111111
          currentBullet = 2
          modifier.hi |= bulletDecelerateY
        }
          //currentBullet += 1
        //if currentBullet > 3 {
          //currentBullet = 1
        //}
      }
    }
  }

  prevA *= 2
  prevB *= 2
  //paddle2ytop = bls[0].y.hi - 8
}

inline void init_graphics() {
  init_sprites()
  load_palletes()
}

inline void load_palletes() {
  byte i
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_pallete_ram) // point the PPU to palette ram
  for i,0,until,$20 {
    ppu_write_data(pallete[i])
  }
}

inline void load_sky_background() {
  word xx
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram) // point the PPU to palette ram
  for xx,0,until,$0800 {
    ppu_write_data(' ') // $00 = sky
  }
}

inline void draw_score_text_background() {
  byte i
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+$40+1) // point the PPU to score text's start
  const array scorebackground = "Money -            HP -"
  for i,0,until,scorebackground.length {
    ppu_write_data(scorebackground[i])
  }
}

inline void draw_boundaries_background() {
  byte i

    //draw top boundary
    read_ppu_status() // read PPU status to reset the high/low latch
    ppu_set_addr(ppu_nametable_ram+$60) // point the PPU to the top boundary's start
    for i,0,until,$20 {
      ppu_write_data($81) //write the top boundary tile
    }

  //draw bottom boundary
  read_ppu_status() // read PPU status to reset the high/low latch
    ppu_set_addr(ppu_nametable_ram+$02C0) // point the PPU to the top boundary's start
    for i,0,until,$20 {
      ppu_write_data($80) //write the bottom boundary tile
    }
}

void draw_game_over_screen() {
  byte i

  //draw the static game over message
  read_ppu_status() // read PPU status to reset the high/low latch
  ppu_set_addr(ppu_nametable_ram+word(10)*32+8) // point the PPU to the message's start
  const array gameover_msg = "G A M E  O V E R"
  for i,0,until,gameover_msg.length {
    ppu_write_data(gameover_msg[i])
  }
  //draw the win message
  //read_ppu_status()
  ppu_set_addr(ppu_nametable_ram+word(14)*32+10)
  const array text = "DONT GIVE UP!"
  for i,0,to,text.length {
    ppu_write_data(text[i])
  }
  //final score
}


void load_play_attribute_table() {
  byte i
    read_ppu_status() // read PPU status to reset the high/low latch
    ppu_set_addr(ppu_nametable_0_attr_ram) // point the PPU to nametable 0's attribute table
    for i,0,until,$10 {
      ppu_write_data(%00000101)
    }
}

void init_sprites() {
  byte i
  for i,0,to,255 {
    if (i & %00000011) == 0 {
      //each sprite takes up 4 bytes, and we want to edit
      //the y position of each sprite (0th byte)
      //so we use the %00000011 mask to write every 4th byte (every 0th sprite byte)

      oam_buffer[i] = $ef // move the sprite off screen
    }
    else {
      oam_buffer[i] = 0
    }
  }
}

byte prevA
byte prevB
void game_init() {
  rollRight = true
  //Set some initial ball stats

  //Set initial paddle states
  rollx.hi = 127
  rolly.hi = 127
  //paddle2ytop = $70
  prevA = 0
  prevB = 0
}

void updateSprites() {
  //TODO re-enable this
  //sprUpdateUpwards = not(sprUpdateUpwards)
  //Update ball sprite
  byte i
  byte j
  array ballSpr [256] @ball_spr1.addr
  //ballSpr[1] = 1
  if sprUpdateUpwards {
    i=0
    while i < bulletCount {
      ballSpr[0+i*4] = bls[i].y.hi
      ballSpr[3+i*4] = bls[i].x.hi
      i += 1
    }
  } else {
    i=bulletCount
    j=0
    while i > 0 {
      i -= 1
      ballSpr[0+j] = bls[i].y.hi
      ballSpr[3+j] = bls[i].x.hi
      j+=4
    }
  }

  array spr [128]@enemy_spr0.addr
  i=0
  j=0
  while i < enemyCount {
    spr[0+j] = enms[i].y.hi
    spr[3+j] = enms[i].x.hi
    if spr[1+j] == $0B {
      spr[0+j+4] = enms[i].y.hi-4
    } else {
      spr[0+j+4] = enms[i].y.hi
    }
    spr[3+j+4] = enms[i].x.hi+8
    if spr[1+j] == $07 {
      if spr[2+j] & %01000000 == 0 {
        spr[3+j] = enms[i].x.hi+1
      } else {
        spr[3+j] = enms[i].x.hi-1
      }
      spr[0+j+4] = enms[i].y.hi+2
    }
    spr[0+j+8] = enms[i].y.hi+8
    spr[3+j+8] = enms[i].x.hi
    spr[0+j+12] = enms[i].y.hi+8
    spr[3+j+12] = enms[i].x.hi+8
    if (timer.lo + i) & %11111 == 0 {
      if spr[1+j] == $07 {
        spr[1+j] += $1
      } else if spr[1+j] == $08 {
        spr[1+j] -= $1
        spr[2+j] ^= %01000000
      } else if spr[1+j] == $09 {
        spr[1+j] += $1
        spr[1+j+8] += $1
        spr[1+j+12] -= $1
      } else if spr[1+j] == $0A {
        spr[1+j] -= $1
        spr[1+j+8] -= $1
        spr[1+j+12] += $1
      } else if spr[1+j+8] == $15 {
        spr[1+j+8] = $06
        enms[i].y.lo |= bulletPierceY
        enms[i].y.hi += 2
      } else if spr[1+j+8] == $06 {
        spr[1+j+8] = $15
        enms[i].y.lo &= (-1)-bulletPierceY
        enms[i].y.hi -= 2
      }
    }
    i += 1
    j += 16
  }

  //update paddle sprites
  // update top of left paddle
  // update body of PLAYER
  if playerInvisible > 1 {playerInvisible -= 1}
  if (playerInvisible & 3) > 0 {
    rollSpr.head.y = rolly.hi - 8
    rollSpr.head.tile = ROLLTOPBOTSPR
    if rollRight {
      rollSpr.head.attrs = ROLLSPRATTR
      rollSpr.body1.attrs = ROLLSPRATTR
      rollSpr.body2.attrs = ROLLSPRATTR

      rollSpr.foot1.attrs = ROLLSPRATTR
      rollSpr.foot1.tile = ROLLFOOT1SPR
      rollSpr.foot2.attrs = ROLLSPRATTR
      rollSpr.foot2.tile = ROLLFOOT2SPR

      rollSpr.arm1.attrs = ROLLSPRATTR
      rollSpr.arm1.x = rollx.hi-5
      rollSpr.arm2.attrs = ROLLSPRATTR
      rollSpr.arm2.x = rollx.hi+5

      rollSpr.ponytail.attrs = ROLLSPRATTR
      rollSpr.ponytail.x = rollx.hi-3
    } else {
      rollSpr.head.attrs = ROLLSPRATTRHFLIP
      rollSpr.body1.attrs = ROLLSPRATTRHFLIP
      rollSpr.body2.attrs = ROLLSPRATTRHFLIP

      rollSpr.foot1.attrs = ROLLSPRATTRHFLIP
      rollSpr.foot1.tile = ROLLFOOT2SPR
      rollSpr.foot2.attrs = ROLLSPRATTRHFLIP
      rollSpr.foot2.tile = ROLLFOOT1SPR

      rollSpr.arm1.attrs = ROLLSPRATTRHFLIP
      rollSpr.arm1.x = rollx.hi+5
      rollSpr.arm2.attrs = ROLLSPRATTRHFLIP
      rollSpr.arm2.x = rollx.hi-5

      rollSpr.ponytail.attrs = ROLLSPRATTRHFLIP
      rollSpr.ponytail.x = rollx.hi+3
    }
    rollSpr.head.x = rollx.hi

    rollSpr.body1.y = rolly.hi
    rollSpr.body1.tile = ROLLBODYSPR
    rollSpr.body1.x = rollx.hi

    rollSpr.body2.y = rolly.hi+8
    rollSpr.body2.tile = ROLLBODY2SPR
    rollSpr.body2.x = rollx.hi

    rollSpr.foot1.y = rolly.hi+14
    rollSpr.foot1.x = rollx.hi-5

    rollSpr.foot2.y = rolly.hi+14
    rollSpr.foot2.x = rollx.hi+5

    rollSpr.arm1.y = rolly.hi+4
    rollSpr.arm1.tile = ROLLARMSPR

    rollSpr.arm2.y = rolly.hi+4
    rollSpr.arm2.tile = ROLLARMSPR

    rollSpr.ponytail.y = rolly.hi-2
    rollSpr.ponytail.tile = ROLLPONYTAILSPR

    rollSpr.ribbon1.y = rolly.hi-4
    rollSpr.ribbon2.y = rolly.hi-4
    rollSpr.ribbon1.x = rollx.hi-3
    rollSpr.ribbon2.x = rollx.hi+3
    rollSpr.ribbon1.tile = ROLLRIBBONSPR
    rollSpr.ribbon2.tile = ROLLRIBBONSPR
    rollSpr.ribbon1.attrs = ROLLSPRATTR
    rollSpr.ribbon2.attrs = ROLLSPRATTRHFLIP
  } else {
    rollSpr.head.y = -1
    rollSpr.body1.y = -1
    rollSpr.body2.y = -1
    rollSpr.foot1.y = -1
    rollSpr.foot2.y = -1
    rollSpr.arm1.y = -1
    rollSpr.arm2.y = -1
    rollSpr.ponytail.y = -1
    rollSpr.ribbon1.y = -1
    rollSpr.ribbon2.y = -1
  }

  // update top of right paddle
  //right_paddle_sprs.head.y = paddle2ytop
  //right_paddle_sprs.head.tile = ROLLTOPBOTSPR
  //right_paddle_sprs.head.attrs = ROLLSPRATTRHVFLIP
  //right_paddle_sprs.head.x = ROLL2X

  //// update body of right paddle
  //right_paddle_sprs.body1.y = paddle2ytop + 8
  //right_paddle_sprs.body1.tile = ROLLBODYSPR
  //right_paddle_sprs.body1.attrs = ROLLSPRATTRHVFLIP
  //right_paddle_sprs.body1.x = ROLL2X

  //right_paddle_sprs.body2.y = paddle2ytop + 16
  //right_paddle_sprs.body2.tile = ROLLBODYSPR
  //right_paddle_sprs.body2.attrs = ROLLSPRATTRHVFLIP
  //right_paddle_sprs.body2.x = ROLL2X

  // update bottom of right paddle
  //right_paddle_sprs.paddlebottom.y = paddle2ytop + 24
  //right_paddle_sprs.paddlebottom.tile = ROLLTOPBOTSPR
  //right_paddle_sprs.paddlebottom.attrs = ROLLSPRATTRHFLIP
  //right_paddle_sprs.paddlebottom.x = ROLL2X
}

inline void drawScore() {
  byte digit01
  byte digit10
  byte digit100
  read_ppu_status() // read PPU status to reset the high/low latch

  //display player1's score
  digit01 = score1 %% 10 //get the ones digit
  digit10 = score1 / 10  //get the tens digit
  digit100 = score1 / 100  //get the tens digit
  digit10 %%= 10
  digit100 %%= 100

  ppu_set_addr(ppu_nametable_ram+$49) // point the PPU to player1's score number
  ppu_write_data(digit100 + '0')
  ppu_write_data(digit10 + '0')
  ppu_write_data(digit01 + '0')

  ppu_set_addr(ppu_nametable_ram+$440+$3C)
  ppu_write_data(digit100 + '0')
  ppu_write_data(digit10 + '0')
  ppu_write_data(digit01 + '0')

  //display score2
  digit01 = score2 %% 10 //get the ones digit
  digit10 = score2 / 10  //get the tens digit
  digit10 %%= 10

  ppu_set_addr(ppu_nametable_ram+$5C) // point the PPU to player2's score number
  ppu_write_data(digit10 + '0')
  ppu_write_data(digit01 + '0')
}


